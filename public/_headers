# Read by Cloudflare Pages (and Netlify): the app shell, manifest and service worker
# are always revalidated so a new version reaches installed apps on the next open.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
